#!/usr/bin/env bash
# qcu shim — invoke the Python package from anywhere.
# Use as:  ./scripts/qcu session start
#          ./scripts/qcu observe
#          ./scripts/qcu act '{"type":"click","ref":"ref_42"}'
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
QCU_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [[ -n "${QCU_PYTHON:-}" ]]; then
  QCU_INTERPRETER="$QCU_PYTHON"
elif [[ -x "$QCU_ROOT/.venv/bin/python" ]]; then
  QCU_INTERPRETER="$QCU_ROOT/.venv/bin/python"
else
  QCU_INTERPRETER="python3"
fi
export PYTHONPATH="$QCU_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$QCU_INTERPRETER" -m qcu "$@"
